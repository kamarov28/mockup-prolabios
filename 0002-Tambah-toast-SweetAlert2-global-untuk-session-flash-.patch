From 647d5170890a10aa7cdf4aee1e44fea9bfb868f5 Mon Sep 17 00:00:00 2001
From: Dev <dev@prolabios.local>
Date: Thu, 13 Aug 2026 01:58:39 +0000
Subject: [PATCH 2/2] Tambah toast SweetAlert2 global untuk session flash
 message di layout frontend

Sebelumnya session('error')/session('success')/session('info') cuma
ditampilkan di beberapa halaman tertentu (cart, rfq-track, admin, login).
Halaman lain (termasuk home, setelah redirect dari fix IDOR RFQ) tidak
menampilkan pesan apa pun ke pengguna. Sekarang layouts/app.blade.php
(dipakai semua halaman publik) menampilkan toast SweetAlert2 di pojok
kanan atas, konsisten dengan pola yang sudah dipakai admin/layout.blade.php.
---
 resources/views/layouts/app.blade.php | 30 +++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/resources/views/layouts/app.blade.php b/resources/views/layouts/app.blade.php
index a0845ed..82a10fe 100644
--- a/resources/views/layouts/app.blade.php
+++ b/resources/views/layouts/app.blade.php
@@ -126,6 +126,36 @@ function closeSearchOverlay() {
     });
   </script>
 
+  @if(session('success') || session('error') || session('info'))
+    <script>
+      document.addEventListener('DOMContentLoaded', function () {
+        if (typeof Swal === 'undefined') return;
+
+        const Toast = Swal.mixin({
+          toast: true,
+          position: 'top-end',
+          showConfirmButton: false,
+          timer: 4000,
+          timerProgressBar: true,
+          didOpen: (toast) => {
+            toast.addEventListener('mouseenter', Swal.stopTimer);
+            toast.addEventListener('mouseleave', Swal.resumeTimer);
+          }
+        });
+
+        @if(session('success'))
+          Toast.fire({ icon: 'success', title: {!! json_encode(session('success')) !!} });
+        @endif
+        @if(session('error'))
+          Toast.fire({ icon: 'error', title: {!! json_encode(session('error')) !!} });
+        @endif
+        @if(session('info'))
+          Toast.fire({ icon: 'info', title: {!! json_encode(session('info')) !!} });
+        @endif
+      });
+    </script>
+  @endif
+
   @stack('scripts')
 
   <!-- Global Search Overlay & Scroll-to-top Button -->
-- 
