includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/
        - routes/
        - database/

    # Level 5 is the standard for stable Laravel/Larastan setups,
    # as level 9 requires strict static types (e.g. array<string, mixed>)
    # and explicit DTOs for every request input.
    level: 5
